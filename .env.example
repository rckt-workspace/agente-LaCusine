# Copie este archivo a .env (no lo versione) y complete los valores reales.
# Nunca escriba credenciales en el código ni en la documentación.

# --- Meta / WhatsApp -------------------------------------------------------
# Secreto de la app de Meta: valida la firma X-Hub-Signature-256.
META_APP_SECRET=
# Token que usted define y registra en Meta para el handshake GET.
META_VERIFY_TOKEN=

# --- Base de datos (Supabase PostgreSQL) -----------------------------------
# Credencial de servidor dedicada; nunca service_role en frontend.
DATABASE_URL=
MAX_WEBHOOK_BODY_BYTES=262144
WEBHOOK_EVENT_RETENTION_DAYS=7

# --- Agente y Claude (todo deshabilitado por defecto) ----------------------
# Modo simulado: usa un proveedor local sin red ni costos. Mantener en true hasta autorización expresa.
AGENT_DRY_RUN=true
# Habilita el cliente real de Anthropic. Solo tiene efecto si AGENT_DRY_RUN=false.
ANTHROPIC_ENABLED=false
ANTHROPIC_API_KEY=
# Modelo: sin valor, el agente no puede llamar a Claude. Candidato verificado el 28/10/2026 en la
# documentación oficial de Anthropic para tareas de alto volumen y baja latencia: claude-haiku-5-5.
ANTHROPIC_MODEL=
ANTHROPIC_MAX_OUTPUT_TOKENS=350
ANTHROPIC_TIMEOUT_SECONDS=20
ANTHROPIC_MAX_RETRIES=1
ANTHROPIC_MAX_CONCURRENCY=2
# Caché de prompts: desactivada. Evaluar costo de escritura antes de activarla (ver docs/agente-ia.md).
ANTHROPIC_PROMPT_CACHING=false
# Apagado de emergencia: true desactiva al agente sin llamadas.
AGENT_KILL_SWITCH=false
AGENT_MAX_INPUT_CHARS=1000
AGENT_MAX_CONTEXT_CHARS=3000

# Tarifas en USD por millón de tokens. Están vacías a propósito: el equipo debe cargarlas.
# Referencia verificada el 28/10/2026 en la página oficial de precios de Anthropic, modelo claude-haiku-5-5,
# prompts de hasta 100.000 tokens: entrada 0.10, salida 0.50, escritura de caché (5 min) 0.125,
# lectura de caché 0.01. Confirmar de nuevo antes de cada presupuesto.
# Sin entrada y salida configuradas no se permite ninguna llamada real.
ANTHROPIC_PRICE_INPUT_USD_PER_MTOK=
ANTHROPIC_PRICE_OUTPUT_USD_PER_MTOK=
ANTHROPIC_PRICE_CACHE_WRITE_USD_PER_MTOK=
ANTHROPIC_PRICE_CACHE_READ_USD_PER_MTOK=
ANTHROPIC_PRICING_REFERENCE=

# Presupuestos en USD estimados. Vacío = sin límite de ese tipo (no recomendado en producción).
AGENT_INTERACTION_LIMIT_USD=
AGENT_DAILY_BUDGET_USD=
AGENT_MONTHLY_BUDGET_USD=

# --- Worker (Fase 4) -------------------------------------------------------
# Desactivado por defecto. Un proceso separado: python -m app.worker.main
WORKER_ENABLED=false
# Identificador del proceso en los leases. Vacío = nombre de host y PID.
WORKER_ID=
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_BATCH_SIZE=10
WORKER_MAX_CONCURRENCY=4
# Debe ser mayor que WORKER_PROCESSING_TIMEOUT_SECONDS (validado al arrancar).
WORKER_LEASE_SECONDS=120
WORKER_PROCESSING_TIMEOUT_SECONDS=60
WORKER_MAX_ATTEMPTS=5
WORKER_BACKOFF_BASE_SECONDS=5
WORKER_BACKOFF_MAX_SECONDS=900

# --- Pruebas ---------------------------------------------------------------
# Solo pruebas de integración. Base LOCAL de loopback cuyo nombre sea exactamente lacusine_test.
# Las pruebas reinician el esquema público: requieren APP_ENV=test y la confirmación exacta
# LACUSINE_TEST_DB_RESET=I_UNDERSTAND_THIS_DROPS_PUBLIC_SCHEMA. Ver README.
TEST_DATABASE_URL=
# Contraseña del contenedor de pruebas de docker-compose.test.yml. Solo local.
LACUSINE_TEST_PG_PASSWORD=
