# Copie este archivo a .env (no lo versione) y complete los valores reales.
# Nunca escriba credenciales en el código ni en la documentación.

# Secreto de la app de Meta: valida la firma X-Hub-Signature-256.
META_APP_SECRET=
# Token que usted define y registra en Meta para el handshake GET.
META_VERIFY_TOKEN=

# Conexión del backend a PostgreSQL (Supabase). Credencial de servidor dedicada; nunca service_role en frontend.
DATABASE_URL=

# Límites y retención
MAX_WEBHOOK_BODY_BYTES=262144
WEBHOOK_EVENT_RETENTION_DAYS=7

# Solo pruebas de integración: base LOCAL cuyo nombre contenga "test". Nunca producción.
TEST_DATABASE_URL=
