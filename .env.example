# Plantilla de configuración. Copie a .env y reemplace los valores <reemplazar>.
# NUNCA ponga claves reales en este archivo. .env está ignorado por Git.

# ===== 1. Entorno y PostgreSQL =====
APP_ENV=local
DATABASE_URL=<reemplazar>
LACUSINE_LOAD_DOTENV=true
# ===== 2. Supabase =====
SUPABASE_JWKS_URL=<reemplazar>
SUPABASE_PUBLISHABLE_KEY=<reemplazar>
SUPABASE_SECRET_KEY=<reemplazar>
SUPABASE_URL=<reemplazar>
# ===== 3. Anthropic =====
ANTHROPIC_API_KEY=<reemplazar>
ANTHROPIC_EFFORT=low
ANTHROPIC_ENABLED=false
ANTHROPIC_MAX_CONCURRENCY=1
ANTHROPIC_MAX_OUTPUT_TOKENS=<reemplazar>
ANTHROPIC_MAX_RETRIES=1
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_PRICE_CACHE_READ_USD_PER_MTOK=0.10
ANTHROPIC_PRICE_CACHE_WRITE_USD_PER_MTOK=2.50
ANTHROPIC_PRICE_INPUT_USD_PER_MTOK=2
ANTHROPIC_PRICE_OUTPUT_USD_PER_MTOK=10
ANTHROPIC_PRICING_MODEL=claude-sonnet-5-5
ANTHROPIC_PRICING_REFERENCE=
ANTHROPIC_PROMPT_CACHING=false
ANTHROPIC_THINKING=between_tools
ANTHROPIC_TIMEOUT_SECONDS=25
# ===== 4. OpenRouter =====
OPENROUTER_API_KEY=<reemplazar>
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MAX_CONCURRENCY=1
OPENROUTER_MAX_OUTPUT_TOKENS=<reemplazar>
OPENROUTER_MAX_RETRIES=1
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_TEMPERATURE=0.20
OPENROUTER_TIMEOUT_SECONDS=25
OPENROUTER_TOP_P=0.80
# ===== 5. Orquestación multimodelo =====
LLM_ENGAGEMENT_ENABLED=false
LLM_ENGAGEMENT_MAX_TOKENS=<reemplazar>
LLM_ENGAGEMENT_MODEL=
LLM_ENGAGEMENT_PROVIDER=openrouter
LLM_ENGAGEMENT_TEMPERATURE=0.10
LLM_ENGAGEMENT_TIMEOUT_SECONDS=20
LLM_ENHANCEMENT_ENABLED=false
LLM_ENHANCEMENT_MAX_TOKENS=<reemplazar>
LLM_ENHANCEMENT_MODEL=claude-haiku-5-5
LLM_ENHANCEMENT_PROVIDER=anthropic
LLM_FALLBACK_ENABLED=false
LLM_FALLBACK_MAX_TOKENS=<reemplazar>
LLM_FALLBACK_MODEL=claude-haiku-5-5
LLM_FALLBACK_ON_AUTH_ERROR=false
LLM_FALLBACK_ON_PROVIDER_UNAVAILABLE=true
LLM_FALLBACK_ON_RATE_LIMIT=true
LLM_FALLBACK_ON_TIMEOUT=false
LLM_FALLBACK_ON_UNCERTAIN=false
LLM_FALLBACK_PROVIDER=anthropic
LLM_FALLBACK_TIMEOUT_SECONDS=25
LLM_JUDGE_ENABLED=false
LLM_JUDGE_MAX_TOKENS=<reemplazar>
LLM_JUDGE_MODEL=claude-sonnet-4-6
LLM_JUDGE_PROVIDER=anthropic
LLM_JUDGE_TIMEOUT_SECONDS=30
LLM_JUDGE_TRIGGER=high_risk_only
LLM_PRIMARY_MAX_TOKENS=<reemplazar>
LLM_PRIMARY_MODEL=google/gemma-4-26b-a4b-it:free
LLM_PRIMARY_PROVIDER=openrouter
LLM_PRIMARY_TEMPERATURE=0.20
LLM_PRIMARY_TIMEOUT_SECONDS=25
LLM_PRIMARY_TOP_P=0.80
LLM_ROUTING_ENABLED=false
# ===== 6. Presupuestos y seguridad =====
AGENT_DAILY_BUDGET_USD=0.20
AGENT_DRY_RUN=true
AGENT_INTERACTION_LIMIT_USD=0.002
AGENT_KILL_SWITCH=false
AGENT_MAX_CONTEXT_CHARS=3000
AGENT_MAX_INPUT_CHARS=1000
AGENT_MONTHLY_BUDGET_USD=3.00
# ===== 7. WhatsApp Cloud API (Meta, NO usado en el piloto web) =====
META_ACCESS_TOKEN=<reemplazar>
META_APP_SECRET=<reemplazar>
META_GRAPH_API_VERSION=v26.0
META_PHONE_NUMBER_ID=<reemplazar>
META_SEND_ENABLED=false
META_VERIFY_TOKEN=<reemplazar>
WHATSAPP_ALLOWED_RECIPIENTS=<reemplazar>
WHATSAPP_DRY_RUN=true
WHATSAPP_MAX_CONCURRENCY=1
WHATSAPP_TIMEOUT_SECONDS=10
# ===== 8. WhatsApp Web / Baileys (transporte del piloto) =====
WHATSAPP_TRANSPORT=cloud_api
WEB_BRIDGE_AUTO_REPLY=false
WEB_BRIDGE_INBOUND_MODE=single_chat
# ===== 9. Worker =====
WORKER_BATCH_SIZE=5
WORKER_ENABLED=false
WORKER_LEASE_SECONDS=120
WORKER_MAX_ATTEMPTS=5
WORKER_MAX_CONCURRENCY=1
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_PROCESSING_TIMEOUT_SECONDS=60
# ===== 10. Transferencia humana =====
ADVISOR_NOTIFIER=simulated
# ===== 11. Demostración =====
DEMO_ENABLED=false
DEMO_PUBLIC_ORIGIN=<reemplazar>
DEMO_TOKEN=<reemplazar>
# ===== Desarrollo local (solo en la máquina de desarrollo) =====
LACUSINE_DB_OWNER_PASSWORD=<reemplazar>
LACUSINE_DEV_ADMIN_PASSWORD=<reemplazar>
LACUSINE_DEV_APP_PASSWORD=<reemplazar>
LACUSINE_LOCAL_APP_SECRET=<reemplazar>
LACUSINE_LOCAL_VERIFY_TOKEN=<reemplazar>
NGROK_AUTHTOKEN=<reemplazar>
# ===== 12. Logging y diagnóstico =====
